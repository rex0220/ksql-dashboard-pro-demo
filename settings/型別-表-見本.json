                      "format": {
                        "kind": "number",
                        "suffix": "%",
                        "decimals": 1
                      }
                    }
                  },
                  "totals": {
                    "売上": "sum"
                  },
                  "rules": [
                    {
                      "kind": "heatmap",
                      "column": "売上"
                    }
                  ]
                }
              },
              {
                "id": "pane7",
                "type": "table",
                "title": "先月の目標達成率(月次目標と JOIN・ヒートマップ)",
                "sql": "SELECT s.担当者名, SUM(s.金額) AS 実績, MAX(g.目標金額) AS 目標,\n  ROUND((SUM(s.金額) * 100) / MAX(g.目標金額), 1) AS 達成率\nFROM APP4239 s INNER JOIN APP4240 g ON s.担当者名 = g.担当者名\n/* JOIN ON の等式は 1 つまで。月の絞り込みは WHERE 側に書く */\nWHERE s.売上日 = LAST_MONTH() AND s.売上ステータス = '確定'\n  AND g.年月 = DATE_FORMAT(DATE_ADD(CURRENT_DATE(), -1, 'MONTH'), '%Y-%m')\nGROUP BY s.担当者名\nORDER BY 達成率 DESC",
                "options": {
