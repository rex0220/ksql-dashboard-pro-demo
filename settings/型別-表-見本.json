              {
                "id": "pane8",
                "type": "table",
                "title": "階層の展開(WITH RECURSIVE)",
                "sql": "WITH RECURSIVE 階層木 AS (\n  SELECT 分類コード, 分類名, 親コード, 1 AS 深さ, 分類名 AS 経路\n  FROM APP4241\n  WHERE 親コード = ''\n  UNION ALL\n  SELECT c.分類コード, c.分類名, c.親コード, p.深さ + 1, CONCAT(p.経路, ' > ', c.分類名)\n  FROM 階層木 p INNER JOIN APP4241 c ON c.親コード = p.分類コード\n)\nSELECT 深さ, 経路, 分類コード\nFROM 階層木\nORDER BY 経路",
                "options": {
                  "density": "compact",
