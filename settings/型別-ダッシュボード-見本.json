    "views": {
      "13335842": {
        "name": "売上ダッシュボード",
        "viewName": "【型別】ダッシュボード",
        "layout": [
          {
            "i": "pane1",
            "x": 0,
            "y": 0,
            "w": 28,
            "h": 3
          },
          {
            "i": "pane3",
            "x": 28,
