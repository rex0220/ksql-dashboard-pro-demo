              },
              {
                "id": "pane4",
                "type": "line",
                "title": "形② X 軸 + 値 — 月次の推移",
                "sql": "SELECT DATE_FORMAT(売上日, '%Y-%m') AS 年月, SUM(金額) AS 売上\nFROM APP4239\nWHERE 売上日 = THIS_YEAR() AND 売上ステータス = '確定' AND 売上日 <= CURRENT_DATE()\nGROUP BY DATE_FORMAT(売上日, '%Y-%m')\nORDER BY 年月",
                "options": {
                  "valueFormat": {
                    "scale": "man",
                    "suffix": "円",
                    "decimals": 0
                  }
                }
              },
              {
                "id": "pane5",
                "type": "line",
                "title": "形② 2 系列 — 今年 vs 前年",
                "sql": "/* 相対日付は WHERE 全体が押し下げできる形でないと使えない。\n   MONTH() での絞り込みを AND で混ぜると拒否されるので、CTE の外へ出す */\nWITH 年比較 AS (\n  SELECT MONTH(売上日) AS 月,\n    SUM(CASE WHEN YEAR(売上日) = YEAR(CURRENT_DATE()) THEN 金額 ELSE 0 END) AS 今年,\n    SUM(CASE WHEN YEAR(売上日) = YEAR(CURRENT_DATE()) - 1 THEN 金額 ELSE 0 END) AS 前年\n  FROM APP4239\n  WHERE (売上日 = THIS_YEAR() OR 売上日 = LAST_YEAR()) AND 売上ステータス = '確定'\n  GROUP BY MONTH(売上日)\n)\nSELECT 月, 今年, 前年\nFROM 年比較\nWHERE 月 <= MONTH(CURRENT_DATE())\nORDER BY 月",
                "options": {
                  "valueFormat": {
                    "scale": "man",
                    "suffix": "円",
                    "decimals": 0
                  }
                }
              }
            ]
          },
