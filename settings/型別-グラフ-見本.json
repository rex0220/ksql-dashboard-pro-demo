                "title": "形① ドーナツ — 部署別の構成比",
                "sql": "SELECT 部署, SUM(金額) AS 売上\nFROM APP4239\nWHERE 売上日 = THIS_YEAR() AND 売上ステータス = '確定'\nGROUP BY 部署\nORDER BY 売上 DESC",
                "options": {
