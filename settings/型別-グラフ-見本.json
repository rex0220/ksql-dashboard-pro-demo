              {
                "id": "pane8",
                "type": "line",
                "title": "取引の無い日を 0 で埋める(GENERATE_SERIES)",
                "sql": "/* 相対日付関数は DECLARE に書けない。CURRENT_DATE() + DATE_ADD を使う */\nDECLARE @from = DATE_ADD(CURRENT_DATE(), -29, 'DAY');\nDECLARE @to = CURRENT_DATE();\nWITH 日付系列 AS (\n  GENERATE_SERIES(@from, @to, '1 day') AS 日付\n),\n日別 AS (\n  SELECT 売上日, SUM(金額) AS 売上\n  FROM APP4239\n  WHERE 売上日 >= @from AND 売上ステータス = '確定'\n  GROUP BY 売上日\n)\n/* LEFT JOIN で一致しない日は 0 ではなく空文字。CASE まで書いて初めて 0 埋めになる */\nSELECT s.日付, CASE WHEN d.売上 = '' THEN 0 ELSE d.売上 END AS 売上\nFROM 日付系列 AS s LEFT JOIN 日別 AS d ON s.日付 = d.売上日\nORDER BY s.日付",
                "options": {
                  "valueFormat": {
                    "scale": "man",
                    "suffix": "円",
                    "decimals": 0
