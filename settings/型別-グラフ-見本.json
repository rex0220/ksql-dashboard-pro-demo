                "title": "形① ラベル + 値 — 商品カテゴリ別の件数",
                "sql": "SELECT 商品カテゴリ, COUNT(*) AS 件数\nFROM APP4239\nWHERE 売上日 = THIS_YEAR() AND 売上ステータス = '確定'\nGROUP BY 商品カテゴリ\nORDER BY 件数 DESC"
              },
              {
                "id": "pane2",
                "type": "barH",
                "title": "形① 横棒 — 長いカテゴリ名はこちら",
                "sql": "SELECT 商品カテゴリ, SUM(金額) AS 売上\nFROM APP4239\nWHERE 売上日 = THIS_YEAR() AND 売上ステータス = '確定'\nGROUP BY 商品カテゴリ\nORDER BY 売上 DESC",
